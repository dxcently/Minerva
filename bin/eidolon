#!/bin/sh
eidolon_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd) || exit 1
for profile in release debug; do
    eidolon_binary="$eidolon_root/eidolon/target/$profile/eidolon.exe"
    if [ -f "$eidolon_binary" ]; then
        exec "$eidolon_binary" "$@"
    fi
done
printf '%s\n' 'Eidolon is not built. Build eidolon-cli first.' >&2
exit 1
