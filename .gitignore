# Local runtime state and credentials
.webui/
.webui_secret_key
**/.webui_secret_key
.cache/
logs/
.env
.env.*
!.env.example
*.key
*.pem

# Large local model weights and compiled runtime
models/
llama.cpp/
# the build `hoot setup -Force` replaced, kept for rollback
llama.cpp.prev/
**/target/
**/node_modules/
**/.venv/
**/venv/
**/__pycache__/
*.pyc
*.gguf
*.safetensors
*.pt
*.pth
# jev's vendored chooser checkpoints (169 KB each) ship with the repo; the
# Wikispeedia one (S56) is the trained baseline the CTF chooser warm-starts from.
!jev/runs/synthetic.pt
!jev/runs/wikispeedia.pt

# Training corpora are large and rebuildable (jev/get-wikispeedia.sh); never staged.
/jev/data/

# eidolon/, harnox/ and aoide-core/ are vendored snapshots (VENDORED.md), tracked.
# Aoide is the full upstream project checked out here for development, with its
# own history and working tree; never stage it as an incomplete gitlink.
/Aoide/

# Machine-specific backups
/bin/PATH-backup.txt
*.orig

# Practice VM images: large, and their license bars redistribution
*.ova
*.ova.part
*.qcow2
