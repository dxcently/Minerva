//! OpenRouter, shipped with the harness.
//!
//! Fetches /models and funnels the listing to the rows this harness can
//! drive: tools in, text out, no `:batch` variants — with the prices
//! parsed from the stringly JSON the gateway serves (`"prompt": "0"`, a
//! string, not `0`, which is the filter this script once died on and
//! answered no rows at all).
//!
pub fn provider() {
    #{
        name: "openrouter",
        wire: "openai",
        base_url: "https://openrouter.ai/api/v1",
        token_secret: "openrouter",
        models: [],
    }
}

/// Whether a list the gateway serves — `supported_parameters`, or an
/// `architecture` modality list — names `want`. Anything that is not a
/// list names nothing.
pub fn names(list, want) {
    if list is Vec {
        for item in list {
            if item is String && item == want {
                return true;
            }
        }
    }
    false
}

/// The `architecture` list under `key` — `output_modalities` or
/// `input_modalities` — or an empty list when the row carries none.
pub fn arch_modalities(model, key) {
    let none = [];
    if let Some(arch) = model.get("architecture") {
        if arch is Object {
            if let Some(v) = arch.get(key) {
                if v is Vec {
                    return v;
                }
            }
        }
    }
    none
}

/// The gateway's rate for a thing, ready for the cost table's $/M
/// arithmetic: every rate the wire serves is a JSON string, and a rate it
/// does not serve — a null `input_cache_read`, say — reads as zero,
/// which is the cost table's priced-as-fresh-input reading, never free.
/// The one-hour cache-write tier is left unread; the standard tier is
/// the one the cost table's single write rate is about.
pub fn rate(pricing, key) {
    let v = match pricing.get(key) {
        Some(v) => v,
        None => return 0.0,
    };
    if v is String {
        match v.parse::<f64>() {
            Ok(f) => f,
            Err(_) => 0.0,
        }
    } else if v is f64 {
        v
    } else if v is i64 {
        v as f64
    } else if v is u64 {
        v as f64
    } else {
        0.0
    }
}

/// The listing funnel: of the gateway's ~460 rows, the ones this harness
/// can drive. A row must put `tools` in `supported_parameters`, nothing
/// but text in `architecture.output_modalities` — the wire spells an
/// image output `["image", "text"]` as often as `["text", "image"]` —
/// and must not be a `:batch` variant, which is the same model at a bulk
/// rate, not a second model. That is the whole gate, and it is why the
/// old embed/tts/whisper substring filter is gone: an embeddings row has
/// no `tools` and drops here like anything else. Rows come back in
/// listing order.
pub fn funnel(data) {
    let out = [];
    if !(data is Vec) {
        return out;
    }
    for model in data {
        if !(model is Object) {
            continue;
        }
        let id_obj = match model.get("id") {
            Some(v) => v,
            None => continue,
        };
        if !(id_obj is String) {
            continue;
        }
        let id = id_obj;
        if id.contains(":batch") {
            continue;
        }
        let sp_obj = match model.get("supported_parameters") {
            Some(v) => v,
            None => continue,
        };
        if !names(sp_obj, "tools") {
            continue;
        }
        let outs = arch_modalities(model, "output_modalities");
        if !names(outs, "text") || names(outs, "image") || names(outs, "audio") || names(outs, "video") {
            continue;
        }
        let name_obj = match model.get("name") {
            Some(v) => v,
            None => continue,
        };
        if !(name_obj is String) {
            continue;
        }
        let name = name_obj;
        let ctx_obj = match model.get("context_length") {
            Some(v) => v,
            None => continue,
        };
        if !(ctx_obj is i64) && !(ctx_obj is u64) {
            continue;
        }
        let ctx = ctx_obj;
        let pricing = match model.get("pricing") {
            Some(v) if v is Object => v,
            _ => continue,
        };
        let reasoning = false;
        if let Some(r_obj) = model.get("reasoning") {
            if r_obj is Object {
                if let Some(m_obj) = r_obj.get("mandatory") {
                    if m_obj is bool {
                        reasoning = m_obj;
                    }
                }
            }
        }
        let input = rate(pricing, "prompt") * 1000000.0;
        let output = rate(pricing, "completion") * 1000000.0;
        let read = rate(pricing, "input_cache_read") * 1000000.0;
        let write = rate(pricing, "input_cache_write") * 1000000.0;
        out.push(#{
            id: id,
            name: name,
            context: ctx,
            reasoning: reasoning,
            vision: names(arch_modalities(model, "input_modalities"), "image"),
            cost: #{
                input: input,
                output: output,
                cache_read: read,
                cache_write: write,
            },
        });
    }
    out
}

pub fn models() {
    let out = [];
    let body = match eidolon::http_get("/models") {
        Ok(b) => b,
        Err(_) => return out,
    };
    let listing = match json::from_string(body) {
        Ok(v) => v,
        Err(_) => return out,
    };
    if !(listing is Object) {
        return out;
    }
    match listing.get("data") {
        Some(data) => funnel(data),
        None => out,
    }
}
