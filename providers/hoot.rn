//! hoot — the llama.cpp router on this box, as an eidolon provider.
//!
//! An ordinary provider script (drop it in `providers_dir`, default
//! `%APPDATA%\eidolon\providers\`): the router serves an OpenAI-compatible
//! surface on loopback, so `wire: "openai"` and a base_url is the whole
//! wiring. No token — the router has no auth and is bound to 127.0.0.1;
//! the placeholder only satisfies clients that insist on sending one.
//!
//! Model ids are the section names in bonsai2\models.ini, and the router
//! loads/swaps them on demand (`--models-max 2`). Speeds are measured on
//! this machine (Ryzen AI 7 PRO 350, tg32): see models.ini's comment block.
//! Costs are zero because the electricity is yours.

pub fn provider() {
    #{
        name: "hoot",
        wire: "openai",
        base_url: "http://127.0.0.1:8080/v1",
        token: "sk-no-key-required",
        models: [
            #{
                id: "Qwen3.8-27B-UD-Q4_K_M",
                name: "Qwen3.8 27B (local, MTP ~3 tok/s)",
                context: 16384,
                reasoning: true,
                vision: true,
                cost: #{ input: 0.0, output: 0.0 },
            },
            #{
                id: "bonsai-8b",
                name: "Bonsai 8B 1-bit (local, ~10 tok/s)",
                context: 16384,
                reasoning: true,
                cost: #{ input: 0.0, output: 0.0 },
            },
            #{
                id: "bonsai-2-27b",
                name: "Bonsai 2 27B ternary (local, ~3 tok/s)",
                context: 32768,
                reasoning: true,
                vision: true,
                cost: #{ input: 0.0, output: 0.0 },
            },
        ],
    }
}
