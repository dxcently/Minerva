
// ===========================================================================
// minerva guard rows: generated by minerva perch, appended to the policy above.
// Do not edit this text; the file it sits in is rewritten at every perch start.
//
// Four refusals for what an agent runs through the shell tool (the leaf table
// is asked once per already-decomposed command):
//
//   1. the aoide CLI. Agents send Aoide mail with the mail_send tool.
//   2. ssh (and sshpass, autossh, mosh). An agent reaches another host through
//      a terminal, so the operator watches it live.
//   3. changing the update keys: `minerva keys` (anything but list and
//      inspect), `minerva web --keys-arm`, perch-open.sh --keys-arm, and
//      `hoot keys`, directly or through powershell.
//   4. any word that names the update-keys directory (minerva/update-keys).
//
// A refusal is judged on the program a command really runs: past env, nohup,
// timeout, xargs, nice, stdbuf, command, exec, flock, strace and the like,
// FOO=bar prefixes and shell keywords (if, then, do, while, !). The code
// string of `bash -c`, `pwsh -Command`, `cmd /c` and `script -c` is read the
// same way, as shell words; that of `python -c`, `perl -e`, `node -e` is read
// only where it starts a command (system(, exec(, popen(, subprocess, a
// backtick). A path that merely names aoide (`ls ~/src/aoide`) or a word in an
// argument (`grep -r aoide .`, `echo ssh`) is not the program.
//
// This is a speed bump, not a boundary: a script on disk, base64 or any other
// disguise gets past it, because eidolon has no sandbox and an agent runs as
// the operator. Code nests six levels deep and no further, a code string over
// 64 KiB is not read, and one command line reads at most 256 KiB of code text
// in all (what is left unread is a miss, never a hang).
// ===========================================================================

const MINERVA_GUARD_AOIDE = "Minerva: agents send Aoide mail with mail_send (opt-in per chat); the aoide CLI is not for agents here";
const MINERVA_GUARD_SSH = "Minerva: ssh through a terminal, term_open then term_send, so the operator watches live";
const MINERVA_GUARD_KEYS = "Minerva: update keys are added by the operator, from the page or a terminal, not by agents";
const MINERVA_GUARD_KEYFILE = "Minerva: the update-keys directory is the operator's; keys are added or removed from the page or a terminal, not through files an agent writes";

const MINERVA_GUARD_WRAPPERS = [
    "env", "nohup", "timeout", "xargs", "nice", "stdbuf", "command", "exec", "setsid", "time", "ionice",
    "flock", "unbuffer", "chrt", "taskset", "watch", "strace",
];
const MINERVA_GUARD_POSITIONAL = ["timeout", "flock", "chrt", "taskset"];
const MINERVA_GUARD_SHELLS = ["sh", "bash", "zsh", "dash", "ksh", "fish", "ash", "csh", "tcsh", "script"];
const MINERVA_GUARD_INTERPRETERS = ["perl", "ruby", "node", "nodejs", "deno", "php"];
const MINERVA_GUARD_POWERSHELLS = ["pwsh", "pwsh.exe", "powershell", "powershell.exe"];
const MINERVA_GUARD_CMDS = ["cmd", "cmd.exe"];
const MINERVA_GUARD_KEYWORDS = ["!", "if", "then", "elif", "else", "do", "while", "until"];
const MINERVA_GUARD_SSHLIKE = ["ssh", "ssh.exe", "sshpass", "autossh", "mosh"];
const MINERVA_GUARD_MARKERS = ["system(", "exec(", "execSync(", "spawn(", "spawnSync(", "popen(", "os.system", "subprocess", "`"];

fn minerva_guard_in(x, list) {
    for item in list {
        if x == item {
            return true;
        }
    }
    false
}

/// The last path component, lower case: `/opt/m/Minerva.exe` and `C:\bin\Minerva.exe` are `minerva.exe`.
fn minerva_guard_base(path) {
    let name = String::new();
    for c in path.chars() {
        if c == '/' || c == '\\' {
            name = String::new();
        } else {
            name.push(c);
        }
    }
    name.to_lowercase()
}

/// The word after its first `n` characters.
fn minerva_guard_skip(s, n) {
    let out = String::new();
    let k = 0;
    for c in s.chars() {
        if k >= n {
            out.push(c);
        }
        k += 1;
    }
    out
}

/// `NAME=value`, the prefix that sets a variable for one command.
fn minerva_guard_assign(word) {
    if let Some((name, _)) = word.split_once('=') {
        if name.len() == 0 {
            return false;
        }
        for c in name.chars() {
            if !(c.is_alphanumeric() || c == '_') {
                return false;
            }
        }
        return true;
    }
    false
}

/// Whether the wrapper's option `flag` takes the next word as its value.
fn minerva_guard_valued(wrapper, flag) {
    match wrapper {
        "env" => minerva_guard_in(flag, ["-u", "-C", "-S", "--unset", "--chdir", "--split-string"]),
        "timeout" => minerva_guard_in(flag, ["-s", "-k", "--signal", "--kill-after"]),
        "nice" => flag == "-n" || flag == "--adjustment",
        "stdbuf" => minerva_guard_in(flag, ["-i", "-o", "-e", "--input", "--output", "--error"]),
        "xargs" => minerva_guard_in(flag, ["-n", "-P", "-I", "-L", "-s", "-d", "-E", "-a", "-J", "--max-args", "--max-procs", "--replace", "--arg-file", "--delimiter"]),
        "exec" => flag == "-a",
        "ionice" => flag == "-c" || flag == "-n" || flag == "-p",
        "time" => minerva_guard_in(flag, ["-o", "-f", "--output", "--format"]),
        "flock" => minerva_guard_in(flag, ["-w", "-E", "--timeout", "--conflict-exit-code"]),
        "taskset" => flag == "-c" || flag == "--cpu-list",
        "watch" => flag == "-n" || flag == "--interval",
        "strace" => minerva_guard_in(flag, ["-e", "-o", "-p", "-s", "-u", "-E", "-a", "-P", "-S", "-I", "-O", "-X", "-b", "-U"]),
        _ => false,
    }
}

/// `[i, texts]`: where the program a command really runs starts in `words`, past NAME=value prefixes, shell keywords and the wrappers
/// that only start another command (with their own options, and the one positional `timeout`, `flock`, `chrt` and `taskset` take), and
/// the values `env -S` was given, which are command lines. `i` is `words.len()` when nothing runs (`command -v ssh` only asks).
fn minerva_guard_start(words, from) {
    let texts = [];
    let i = from;
    while i < words.len() {
        let w = words[i];
        if minerva_guard_assign(w) || minerva_guard_in(w, MINERVA_GUARD_KEYWORDS) {
            i += 1;
            continue;
        }
        let b = minerva_guard_base(w);
        if !minerva_guard_in(b, MINERVA_GUARD_WRAPPERS) {
            return [i, texts];
        }
        i += 1;
        let positional = minerva_guard_in(b, MINERVA_GUARD_POSITIONAL);
        while i < words.len() {
            let o = words[i];
            if o == "--" {
                i += 1;
                break;
            }
            if o.len() < 2 || !o.starts_with("-") {
                break;
            }
            if b == "command" && (o == "-v" || o == "-V") {
                return [words.len(), texts];
            }
            i += 1;
            if b == "env" {
                if o == "-S" || o == "--split-string" {
                    if i < words.len() {
                        texts.push(words[i]);
                        i += 1;
                    }
                    continue;
                }
                if o.starts_with("--split-string=") {
                    texts.push(minerva_guard_skip(o, 15));
                    continue;
                }
                if o.starts_with("-S") && !o.starts_with("--") {
                    texts.push(minerva_guard_skip(o, 2));
                    continue;
                }
            }
            if b == "taskset" && (o == "-c" || o == "--cpu-list") {
                positional = false;
            }
            if minerva_guard_valued(b, o) {
                i += 1;
            }
        }
        if positional && i < words.len() {
            i += 1;
        }
    }
    [i, texts]
}

/// `words` joined by single spaces, from index `from`.
fn minerva_guard_join(words, from) {
    let out = String::new();
    let first = true;
    let i = from;
    while i < words.len() {
        if !first {
            out.push(' ');
        }
        out.push_str(words[i]);
        first = false;
        i += 1;
    }
    out
}

/// Whether `word` is one of `words[from..]`.
fn minerva_guard_later(words, from, word) {
    let i = from;
    while i < words.len() {
        if words[i] == word {
            return true;
        }
        i += 1;
    }
    false
}

/// `hoot`, `hoot.ps1`, `hoot.cmd` or a path ending in one of them.
fn minerva_guard_is_hoot(b) {
    b == "hoot" || b.ends_with("hoot.ps1") || b.ends_with("hoot.cmd")
}

/// `hoot keys` (or `hoot.ps1 keys`) as a program or as the script of a runner: a hoot word with `keys` after it.
fn minerva_guard_hoot(words, from) {
    let i = from;
    while i < words.len() {
        if minerva_guard_is_hoot(minerva_guard_base(words[i])) && minerva_guard_later(words, i + 1, "keys") {
            return true;
        }
        i += 1;
    }
    false
}

/// 1 for a shell, 2 for a language that takes its program as an option (python, perl, node), 3 for powershell, 4 for cmd, 0 for the rest.
fn minerva_guard_flavor(prog) {
    if minerva_guard_in(prog, MINERVA_GUARD_SHELLS) {
        return 1;
    }
    if prog.starts_with("python") || minerva_guard_in(prog, MINERVA_GUARD_INTERPRETERS) {
        return 2;
    }
    if minerva_guard_in(prog, MINERVA_GUARD_POWERSHELLS) {
        return 3;
    }
    if minerva_guard_in(prog, MINERVA_GUARD_CMDS) {
        return 4;
    }
    0
}

/// Whether `flag` is an option after which the next word is program text. A shell: any short option with a `c` in it (`-c`, `-lc`, `-ec`,
/// `-cx`) or --command. A language: an option that ends in c, e, r or p (`-c`, `-e`, `-ne`, `-r`, `-p`) or --eval, --print, --command.
/// Powershell: -Command and its prefixes (`-c`, `-com`). cmd: /c, /k and /r.
fn minerva_guard_code_flag(flavor, flag) {
    if flavor == 1 {
        if flag == "--command" {
            return true;
        }
        return flag.len() >= 2 && flag.starts_with("-") && !flag.starts_with("--") && flag.contains("c");
    }
    let f = flag.to_lowercase();
    if flavor == 2 {
        if f == "--command" || f == "--eval" || f == "--print" {
            return true;
        }
        if f.len() < 2 || !f.starts_with("-") || f.starts_with("--") {
            return false;
        }
        return f.ends_with("c") || f.ends_with("e") || f.ends_with("r") || f.ends_with("p");
    }
    if flavor == 3 {
        return f.len() >= 2 && f.starts_with("-") && !f.starts_with("--") && "-command".starts_with(f);
    }
    f == "/c" || f == "/k" || f == "/r"
}

/// `text` as shell words in command segments. `;` `&` `|` `(` `)` `{` `}` a backtick and a newline end a segment, blanks end a word, and
/// quotes and backslashes only glue pieces together (`a"o"ide` is `aoide`). Words are never empty, and neither are segments. With `code`
/// the text is a language's, not a shell's: `(` `{` `}` are ordinary characters, `,` `[` `]` are blanks, and with `first_only` the answer
/// is the first segment alone.
fn minerva_guard_segments(text, code, first_only) {
    let segments = [];
    let words = [];
    let word = String::new();
    for c in text.chars() {
        if c == '\\' || c == '"' || c == '\'' {
            continue;
        }
        if c == ' ' || c == '\t' || (code && (c == ',' || c == '[' || c == ']')) {
            if word.len() > 0 {
                words.push(word);
                word = String::new();
            }
            continue;
        }
        let boundary = c == ';' || c == '&' || c == '|' || c == ')' || c == '`' || c == '\n' || c == '\r' || (!code && (c == '(' || c == '{' || c == '}'));
        if boundary {
            if word.len() > 0 {
                words.push(word);
                word = String::new();
            }
            if words.len() > 0 {
                segments.push(words);
                words = [];
                if first_only {
                    return segments;
                }
            }
            continue;
        }
        word.push(c);
    }
    if word.len() > 0 {
        words.push(word);
    }
    if words.len() > 0 {
        segments.push(words);
    }
    segments
}

/// Takes `n + 1` from the work budget `budget[0]` (the bytes of code text one command line may still have read), or says there is not
/// that much left. Without it a command that nests the same flag over and over would be read once per way of nesting it.
fn minerva_guard_charge(budget, n) {
    if n + 1 > budget[0] {
        return false;
    }
    budget[0] = budget[0] - n - 1;
    true
}

/// The sentence for the first segment of the shell text `text` that is refused, else "".
fn minerva_guard_text(text, depth, budget) {
    if depth > 6 || text.len() > 65536 || !minerva_guard_charge(budget, text.len()) {
        return "";
    }
    // The key directory named anywhere in a shell text, before the backslashes of a Windows path are read as escapes.
    if text.to_lowercase().replace("\\", "/").contains("minerva/update-keys") {
        return MINERVA_GUARD_KEYFILE;
    }
    for words in minerva_guard_segments(text, false, false) {
        let refused = minerva_guard_judge(words, depth + 1, budget);
        if refused != "" {
            return refused;
        }
    }
    ""
}

/// `s` without its leading run of the characters a call opens with (blanks, `(`, `[`, `{`, quotes, `,`), and with `ident` also without an
/// identifier tail first (`.run` in `subprocess.run(`).
fn minerva_guard_lead(s, ident) {
    let out = String::new();
    let started = false;
    let in_ident = ident;
    for c in s.chars() {
        if started {
            out.push(c);
            continue;
        }
        if in_ident {
            if c.is_alphanumeric() || c == '_' || c == '.' {
                continue;
            }
            in_ident = false;
        }
        if c == ' ' || c == '\t' || c == '(' || c == '[' || c == '{' || c == '"' || c == '\'' || c == ',' {
            continue;
        }
        started = true;
        out.push(c);
    }
    out
}

/// The sentence for a command a language's code string starts, else "": the text after `system(`, `exec(`, `popen(`, `subprocess`, a backtick
/// and the like, up to the end of that one command. Nothing else in the code is read, so `print(aoide)` is not a command.
fn minerva_guard_code(text, depth, budget) {
    if depth > 6 || text.len() > 65536 || !minerva_guard_charge(budget, text.len()) {
        return "";
    }
    for marker in MINERVA_GUARD_MARKERS {
        let rest = text;
        let n = 0;
        while n < 16 {
            let parts = rest.split_once(marker);
            let after = match parts {
                Some((_, after)) => after,
                None => break,
            };
            n += 1;
            rest = after;
            let tail = minerva_guard_lead(after, marker == "subprocess");
            for words in minerva_guard_segments(tail, true, true) {
                let refused = minerva_guard_judge(words, depth + 1, budget);
                if refused != "" {
                    return refused;
                }
            }
        }
    }
    ""
}

/// The sentence if one command (a program and its arguments, as the leaf table gets it) is refused, else "". The entry point of the rows.
fn minerva_guard_words(words, depth) {
    minerva_guard_judge(words, depth, [262144])
}

fn minerva_guard_judge(words, depth, budget) {
    if depth > 6 {
        return "";
    }
    let found = minerva_guard_start(words, 0);
    let p = found[0];
    for t in found[1] {
        let refused = minerva_guard_text(t, depth, budget);
        if refused != "" {
            return refused;
        }
    }
    if p >= words.len() {
        return "";
    }
    let first = words[p];
    // A program word with a blank in it is a command line quoted as one word (`watch "ssh h"`).
    if first.contains(" ") || first.contains("\t") {
        let refused = minerva_guard_text(first, depth, budget);
        if refused != "" {
            return refused;
        }
    }
    let prog = minerva_guard_base(first);

    let arm = false;
    let opener = false;
    let keyfile = false;
    for w in words {
        if w == "--keys-arm" || w.starts_with("--keys-arm=") {
            arm = true;
        }
        if minerva_guard_base(w) == "perch-open.sh" {
            opener = true;
        }
        if w.to_lowercase().replace("\\", "/").contains("minerva/update-keys") {
            keyfile = true;
        }
    }

    if prog == "aoide" || prog == "aoide.exe" || prog == "aoided" || prog == "aoided.exe" {
        return MINERVA_GUARD_AOIDE;
    }
    if minerva_guard_in(prog, MINERVA_GUARD_SSHLIKE) {
        return MINERVA_GUARD_SSH;
    }
    if keyfile {
        return MINERVA_GUARD_KEYFILE;
    }

    let minerva = prog == "minerva" || prog == "minerva.exe";
    if minerva && p + 1 < words.len() && words[p + 1] == "keys" {
        let verb = "";
        let j = p + 2;
        while j < words.len() {
            if !words[j].starts_with("-") {
                verb = words[j];
                break;
            }
            j += 1;
        }
        if verb != "" && verb != "list" && verb != "inspect" {
            return MINERVA_GUARD_KEYS;
        }
    }
    if arm && (opener || minerva) {
        return MINERVA_GUARD_KEYS;
    }

    let flavor = minerva_guard_flavor(prog);
    if (minerva_guard_is_hoot(prog) || flavor > 0) && minerva_guard_hoot(words, p) {
        return MINERVA_GUARD_KEYS;
    }

    if flavor > 0 {
        let k = p + 1;
        let seen = 0;
        while k < words.len() && seen < 16 {
            if minerva_guard_code_flag(flavor, words[k]) {
                seen += 1;
                let from = k + 1;
                if from < words.len() && words[from] == "--" {
                    from += 1;
                }
                let text = minerva_guard_join(words, from);
                let refused = if flavor == 2 { minerva_guard_code(text, depth, budget) } else { minerva_guard_text(text, depth, budget) };
                if refused != "" {
                    return refused;
                }
            }
            k += 1;
        }
        return "";
    }
    if prog == "eval" {
        return minerva_guard_text(minerva_guard_join(words, p + 1), depth, budget);
    }
    if prog == "find" {
        let k = p + 1;
        while k < words.len() {
            let t = words[k];
            if t == "-exec" || t == "-execdir" || t == "-ok" || t == "-okdir" {
                let rest = [];
                let m = k + 1;
                while m < words.len() && words[m] != ";" && words[m] != "+" {
                    rest.push(words[m]);
                    m += 1;
                }
                let refused = minerva_guard_judge(rest, depth + 1, budget);
                if refused != "" {
                    return refused;
                }
                k = m + 1;
            } else {
                k += 1;
            }
        }
    }
    ""
}
