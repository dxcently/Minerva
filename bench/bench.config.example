# bench run config (triage-toolkit.md §7.6). `key = value`, `#` comments.
# Copy, fill score_cmd for your setup, and pass with --config.

# §7.6 recorded settings
brain_model     = ollama:deepseek-v4.1-flash
feedback        = blind        # blind | feedback
time_box_s      = 7200         # 2 h per run
repeats         = 3

# Operational
poll_interval_s = 30
boot_timeout_s  = 300
score_settle_s  = 30           # after the agent stops, before the final read (phocus rescores ~every 15 s)
score_total     = 256

# The VM harness. vm_cmd <verb> runs down/reset/up; score_cmd prints one
# `score N/T ...` line read over ssh from Aeacus's report (an unreachable guest
# prints nothing, so the loop retries; an agent that locks ssh has cut its own
# hands too); ready_cmd waits for boot AND a post-boot report, because the
# first report of a boot is wrong (8/256 on a clean image). Split on spaces.
# These invoke the WSL script from Windows; adjust for your host.
vm_cmd    = wsl -e /mnt/c/Users/dxcen/Projects/Minerva/bin/botforge-vm.sh
score_cmd = wsl -e /mnt/c/Users/dxcen/Projects/Minerva/bin/botforge-vm.sh score
ready_cmd = wsl -e /mnt/c/Users/dxcen/Projects/Minerva/bin/botforge-vm.sh ready

# §7.4 honesty checks (detection; the agent is root, so a hit invalidates a run)
allowed_tools = fs, ssh, vm_read
deny_paths    = /opt/aeacus, ScoringReport.html, scoring.dat

# Provenance for the report row
image           = botforge-practice-v2
image_sha       =
graphs_snapshot =
